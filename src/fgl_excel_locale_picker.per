END --LAYOUT

ATTRIBUTES

	EDIT fld001 = formonly.localeTag, SCROLL;
	EDIT fld002 = formonly.displayName, SCROLL;
	EDIT fld003 = formonly.dateFormat, SCROLL;
	EDIT fld004 = formonly.currencySymbol, SCROLL;

END --ATTRIBUTES

INSTRUCTIONS

	SCREEN RECORD s_locales(formonly.localeTag, formonly.displayName,
	                        formonly.dateFormat, formonly.currencySymbol);

END --INSTRUCTIONS
